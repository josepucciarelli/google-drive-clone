# Copy to .env.local and fill in the endpoint, project ID and API key.
# The endpoint includes your project's region (e.g. nyc, fra, sfo).
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://nyc.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT=""

# IDs used by `npm run setup:appwrite`. You can leave them as they are.
NEXT_PUBLIC_APPWRITE_DATABASE="drive"
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION="users"
NEXT_PUBLIC_APPWRITE_FILES_COLLECTION="files"
NEXT_PUBLIC_APPWRITE_BUCKET="uploads"

# Secret: server only, never commit it.
NEXT_APPWRITE_KEY=""
